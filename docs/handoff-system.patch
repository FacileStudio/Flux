diff --git a/pkgs/flux-install/flux-install.sh b/pkgs/flux-install/flux-install.sh
index 80dd44f..2d2ec71 100644
--- a/pkgs/flux-install/flux-install.sh
+++ b/pkgs/flux-install/flux-install.sh
@@ -258,19 +258,27 @@ configure() {
   mv /mnt/etc/nixos/hardware-configuration.nix /mnt/etc/flux/
   rm -rf /mnt/etc/nixos
   sed -i "s|system = \"x86_64-linux\";|system = \"$system\";|" /mnt/etc/flux/flake.nix
-  sed -i \
-    -e "s|^  hostName = .*;|  hostName = \"$hostname\";|" \
-    -e "s|^  userName = .*;|  userName = \"$username\";|" \
-    -e "s|^  fullName = .*;|  fullName = \"$full_name\";|" \
-    -e "s|^  hashedPassword = .*;|  hashedPassword = \"$hashed\";|" \
-    -e "s|^  timeZone = .*;|  timeZone = \"$timezone\";|" \
-    -e "s|^  keyMap = .*;|  keyMap = \"$keymap\";|" \
-    -e "s|^  locale = .*;|  locale = \"$locale\";|" \
-    -e "s|^  system.stateVersion = .*;|  system.stateVersion = \"$release\";|" \
-    /mnt/etc/flux/configuration.nix
+  sed -i "s|^  system.stateVersion = .*;|  system.stateVersion = \"$release\";|" /mnt/etc/flux/configuration.nix
+  settings_json >/mnt/etc/flux/settings.json
+  chmod 0644 /mnt/etc/flux/settings.json
   emit config 30 "Configuration written to /etc/flux"
 }
 
+settings_json() {
+  printf '{\n  "version": 1,\n  "hostname": "%s",\n  "timezone": "%s",\n  "locale": "%s",\n' \
+    "$hostname" "$timezone" "$locale"
+  printf '  "formats": null,\n  "keymap": "%s",\n  "users": [\n' "$keymap"
+  printf '    { "name": "%s", "fullName": "%s", "admin": true, "groups": ["networkmanager", "video", "audio"] }\n' \
+    "$username" "$(json_escape "$full_name")"
+  printf '  ],\n  "updates": { "automatic": false }\n}\n'
+}
+
+set_password() {
+  step=password
+  printf '%s:%s\n' "$username" "$hashed" | nixos-enter --root /mnt -c 'chpasswd -e' >>"$log" 2>&1 \
+    || fail "could not set the password of $username, see $log"
+}
+
 track() {
   local line copied=0 built=0 shown=30 percent
   while IFS= read -r line; do
@@ -301,6 +309,7 @@ install_system() {
   else
     nixos-install --flake /mnt/etc/flux#flux --no-root-passwd 2>&1 | tee -a "$log"
   fi
+  set_password
   step="done"
   emit "done" 100 "Flux is installed. Your system flake lives in /etc/flux."
 }
diff --git a/template/README.md b/template/README.md
index db71532..a500e4b 100644
--- a/template/README.md
+++ b/template/README.md
@@ -1,16 +1,19 @@
 # My Flux machine
 
-This flake describes one machine running Flux. `flux-install` writes it to `/etc/flux`. You own it: edit `configuration.nix`, then rebuild.
+This flake describes one machine running Flux. `flux-install` writes it to `/etc/flux`. You own it.
+
+- `settings.json` holds the device name, time zone, language, keyboard layout and accounts. Settings edits it for you; `flux-config` does the same from a terminal. Passwords are not in it: they stay in `/etc/shadow`.
+- `configuration.nix` is yours for anything else. A value in `settings.json` wins over the same option set here.
 
 ## Update
 
+Open Settings, then Updates. From a terminal:
+
 ```sh
-cd /etc/flux
-sudo nix flake update
-sudo nixos-rebuild switch --flake /etc/flux#flux
+pkexec flux-config update
 ```
 
-`nix flake update` moves Flux and nixpkgs to their latest commits and records them in `flake.lock`. `nixos-rebuild switch` builds and activates the result. Roll back with `sudo nixos-rebuild switch --rollback`, or pick an older generation in the boot menu.
+That moves the `flux` input to its latest revision, records it in `flake.lock` and switches to the result. `pkexec flux-config rollback` goes back one version; older versions also stay in the boot menu.
 
 ## Start from scratch
 
@@ -19,4 +22,4 @@ nix flake init -t github:FacileStudio/Flux
 sudo nixos-generate-config --show-hardware-config > hardware-configuration.nix
 ```
 
-Then set `hostName`, `userName`, `fullName`, `hashedPassword`, `timeZone`, `keyMap` (an xkb layout such as `fr`, also used on the console) and `locale` at the top of `configuration.nix`. Generate the hash with `mkpasswd`. The default `"!"` locks password login. On an aarch64 machine, change `system` in `flake.nix` to `"aarch64-linux"`.
+Edit `settings.json` (the schema is in `docs/settings-json.md` of the Flux repository). After `nixos-install`, set each account's password with `nixos-enter --root /mnt -c 'passwd <name>'`; until then the account cannot sign in. On an aarch64 machine, change `system` in `flake.nix` to `"aarch64-linux"`.
