let mapleader = " "
set tabstop=4
set shiftwidth=4
set expandtab
set number
set smartindent
syntax enable

function! ToggleFileExplorer()
    let l:winNr = 1
    let l:found = 0
    while l:winNr <= winnr('$')
        if getbufvar(winbufnr(l:winNr), '&filetype') ==# 'netrw'
            let l:found = l:winNr
            break
        endif
        let l:winNr += 1
    endwhile

    if l:found
        exec l:found . 'wincmd c'
    else
        Sexplore
        wincmd H
        vertical resize 25
    endif
endfunction

nnoremap <C-n> :call ToggleFileExplorer()<CR>
